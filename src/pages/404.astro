---
import Base from '../layouts/Base.astro';
import { cuatrocientoscuatro as t } from '../content/martina';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base titulo={`${t.titulo} · Flores amarillas para Martina`} simple>
  <main class="perdida" id="contenido">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1 class="display perdida__titulo">{t.titulo}</h1>
      <p class="perdida__bajada">{t.bajada}</p>
      <a class="btn" href={base}>{t.boton}</a>
    </div>
  </main>
</Base>

<style>
  .perdida {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: var(--space-xl);
  }
  .perdida .container {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .perdida__titulo {
    font-size: var(--step-4);
    max-width: 8em;
  }
  .perdida__bajada {
    font-size: var(--step-1);
    color: var(--ink-2);
  }
</style>
